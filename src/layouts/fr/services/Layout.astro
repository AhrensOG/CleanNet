---
// src/pages/fr/services.astro
import Footer from "../../../components/navigation/fr/footer/Footer.astro";
import Navbar from "../../../components/navigation/fr/navbar/Navbar.astro";
import WhatsAppButton from "../../../components/WhatsAppButton.astro";
import "../../../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Services – Clean Net Genève</title>
    <meta
      name="description"
      content="Découvrez tous les services professionnels proposés par CleanNet à Genève : nettoyage, rénovation, conciergerie, déménagement, et plus encore."
    />

    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-17131857885"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "AW-17131857885");
    </script>

    <!-- Alpine.js -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/alpinejs" defer
    ></script>

    <script src="/scripts/convertion.js" is:inline></script>
  </head>
  <body class="min-h-screen bg-white antialiased">
    <!-- Navbar global -->
    <Navbar />

    <!-- Contenu principal de la page Services -->
    <slot />

    <!-- Footer global -->
    <Footer />
    <WhatsAppButton />
  </body>
</html>

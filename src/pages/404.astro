<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting...</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      const supported = ["fr", "en"];
      const lang = navigator.language?.split("-")[0]?.toLowerCase() || "fr";
      const redirectLang = supported.includes(lang) ? lang : "fr";
      window.location.replace(`/${redirectLang}/404`);
    </script>
  </head>
  <body>
    <p style="text-align:center;margin-top:2rem;font-family:sans-serif;">
      Redirecting to your language’s 404 page...
    </p>
  </body>
</html>

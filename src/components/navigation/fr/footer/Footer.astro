---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0E0C2C] text-white py-16 px-6">
  <div class="max-w-7xl mx-auto grid md:grid-cols-4 gap-10">
    <!-- Logo et description -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <a href="/fr">
          <img src="/cleannet.png" alt="Logo CleanNet" class="w-36 h-20" />
        </a>
      </div>
      <p class="text-sm text-[#BDBAC1]">
        Services de nettoyage professionnels<br />
        combinant technologie et savoir-faire humain.
      </p>
    </div>

    <!-- Liens Entreprise -->
    <div>
      <h4 class="text-white font-semibold mb-4">Entreprise</h4>
      <ul class="space-y-2 text-sm text-[#BDBAC1]">
        <li><a href="/fr" class="hover:text-white">Accueil</a></li>
        <li><a href="/fr/services" class="hover:text-white">Services</a></li>
        <li><a href="/fr/#about" class="hover:text-white">À propos</a></li>
        <li><a href="/fr/contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>

    <!-- Liens Services -->
    <div>
      <h4 class="text-white font-semibold mb-4">Nos services</h4>
      <ul class="space-y-2 text-sm text-[#BDBAC1]">
        <li>
          <a href="/fr/services" class="hover:text-white"
            >Nettoyage résidentiel</a
          >
        </li>
        <li>
          <a href="/fr/services" class="hover:text-white">Nettoyage de vitres</a
          >
        </li>
        <li>
          <a href="/fr/services" class="hover:text-white">Désinsectisation</a>
        </li>
        <li>
          <a href="/fr/services" class="hover:text-white">Entretien des sols</a>
        </li>
      </ul>
    </div>

    <!-- Contact et WhatsApp -->
    <div class="space-y-4">
      <h4 class="text-white font-semibold mb-4">Contact</h4>
      <p class="text-sm text-[#BDBAC1]">
        📍 Rue de Lausanne 123, 1202 Genève<br />
        📞 +41 79 642 52 97<br />
        📧 contact@cleannet.ch
      </p>
      <a
        href="https://wa.me/41796425297?text=Bonjour%20CleanNet%2C%20je%20souhaite%20obtenir%20un%20devis."
        target="_blank"
        rel="noopener noreferrer"
        onclick="trackConversion()"
        class="inline-block bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-full text-sm font-medium shadow-md transition">
        💬 Discuter sur WhatsApp
      </a>
    </div>
  </div>

  <!-- Bas de page -->
  <div
    class="border-t border-white/10 mt-12 pt-6 text-center text-sm text-[#BDBAC1]">
    © {currentYear} CleanNet. Tous droits réservés.
  </div>
</footer>

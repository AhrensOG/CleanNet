---
import { Phone, Menu, X } from "@lucide/astro";
---

<!-- Barre supérieure -->
<div
  class="bg-[#3349FF] h-auto md:h-11 text-white text-xs md:text-xl font-bold py-2 px-4 flex flex-col md:flex-row justify-center items-center gap-1 md:gap-2 text-center">
  <span>Besoin d'une aide rapide pour le nettoyage ?</span>
  <div class="flex items-center gap-2">
    <Phone size={20} class="text-white" />
    <span>Appelez-nous : +41 079 642 5297</span>
  </div>
</div>

<!-- Header avec menu responsive -->
<header
  x-data="{ open: false }"
  class="relative z-50 w-full bg-white px-6 sm:px-16 py-4 flex justify-between items-center shadow-md">
  <!-- Logo -->
  <div class="flex items-center gap-2">
    <a href="/fr" title="Accueil">
      <img
        src="/cleannet.png"
        alt="Logo CleanNet"
        class="w-32 sm:w-36 h-auto object-contain rounded-md"
        title="CleanNet logo - Geneva cleaning company"
      />
    </a>
  </div>

  <!-- Menu de navigation desktop -->
  <nav class="hidden md:flex text-lg gap-6 text-cleannet-blue font-bold">
    <a href="/fr" title="Accueil" class="hover:text-[#EB6C26] transition">Accueil</a>
    <a href="/fr#about" title="Nos valeurs" class="hover:text-[#EB6C26] transition">À propos</a>
    <a href="/fr/services" title="Tous nos services" class="hover:text-[#EB6C26] transition">Services</a>
    <a href="/fr/contact" title="Contact" class="hover:text-[#EB6C26] transition">Contact</a>
  </nav>

  <!-- CTA + Sélecteur de langue -->
  <div class="hidden md:flex items-center gap-4">
    <a
      href="https://wa.me/41796425297?text=Bonjour%20CleanNet%2C%20je%20souhaite%20demander%20un%20devis"
      target="_blank"
      rel="noopener noreferrer"
      title="Write to us"
      
      class="bg-cleannet-orange text-white px-5 py-2 rounded-full font-semibold hover:bg-orange-600 transition text-sm md:text-base">
      Write to us
    </a>

    <select
      onchange="location = this.value"
      class="text-sm md:text-base font-semibold border border-gray-300 rounded-md px-3 py-1 bg-white text-cleannet-orange focus:outline-none"
      aria-label="Sélection de langue">
      <option value="/fr" selected>FR</option>
      <option value="/en">EN</option>
    </select>
  </div>

  <!-- Burger icon -->
  <button class="md:hidden ml-auto" @click="open = !open">
    <Menu size={28} class="text-[#33499B]" x-show="!open" />
    <X size={28} class="text-[#33499B]" x-show="open" />
  </button>

  <!-- Mobile menu -->
  <div
    x-show="open"
    x-transition
    class="absolute top-full left-0 w-full bg-white shadow-lg md:hidden flex flex-col items-center text-cleannet-blue font-bold text-base py-4 space-y-4">
    <a href="/fr" title="Accueil" class="hover:text-[#EB6C26]" @click="open = false">Accueil</a>
    <a href="/fr#about" class="hover:text-[#EB6C26]" @click="open = false"
      >À propos</a
    >
    <a href="/fr/services" title="Tous nos services" class="hover:text-[#EB6C26]" @click="open = false"
      >Services</a
    >
    <a href="/fr/contact" title="Contact" class="hover:text-[#EB6C26]" @click="open = false"
      >Contact</a
    >
    <a
      href="https://wa.me/41796425297?text=Bonjour%20CleanNet%2C%20je%20souhaite%20demander%20un%20devis"
      target="_blank"
      rel="noopener noreferrer"
      title="Write to us"
      
      class="bg-cleannet-orange text-white px-5 py-2 rounded-full font-semibold hover:bg-orange-600 transition">
      Write to us
    </a>
    <select
      onchange="location = this.value"
      class="text-sm font-semibold border border-gray-300 rounded-md px-3 py-1 bg-white text-cleannet-orange focus:outline-none"
      aria-label="Sélection de langue">
      <option value="/fr" selected>FR</option>
      <option value="/en">EN</option>
    </select>
  </div>
</header>

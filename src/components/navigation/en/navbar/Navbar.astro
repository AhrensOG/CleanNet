---
import { Phone, Menu } from "@lucide/astro";
---

<!-- Top bar with phone contact -->
<div
  class="bg-[#3349FF] h-11 text-white text-center text-xs font-bold md:text-xl py-2 px-4 flex justify-center items-center gap-2">
  <span>Need fast help with cleaning?</span>
  <Phone size={20} fill="#fff" class="text-white" />
  <span>Call us: +41 079 642 5297</span>
</div>

<!-- Main Navigation -->
<header
  class="absolute w-full top-11 z-10 px-6 sm:px-16 py-4 flex justify-between items-center bg-transparent">
  <!-- Logo -->
  <div class="flex items-center gap-2">
    <a href="/en">
      <img
        src="/cleannet.png"
        alt="CleanNet logo - Geneva cleaning company"
        class="w-36 h-auto rounded-md object-contain"
      />
    </a>
  </div>

  <!-- Desktop Navigation Menu -->
  <nav class="hidden md:flex text-lg gap-6 text-cleannet-blue font-bold">
    <a href="/en" class="hover:text-[#EB6C26] transition">Home</a>
    <a href="/en#about" class="hover:text-[#EB6C26] transition">About</a>
    <a href="/en/services" class="hover:text-[#EB6C26] transition">Services</a>
    <a href="/en/contact" class="hover:text-[#EB6C26] transition">Contact</a>
  </nav>

  <!-- CTA + Language Selector -->
  <div class="flex items-center gap-4">
    <!-- Book Appointment Button -->
    <a
      href="https://calendly.com/cleannet1963/30min"
      target="_blank"
      rel="noopener noreferrer"
      onclick="trackConversion()"
      class="bg-cleannet-orange hidden sm:block text-white px-5 py-2 rounded-full font-semibold hover:bg-orange-600 transition text-sm md:text-base">
      Book an Appointment
    </a>

    <!-- Language Switcher -->
    <select
      onchange="location = this.value"
      class="text-sm md:text-base font-semibold border border-gray-300 rounded-md px-3 py-1 bg-white text-cleannet-orange focus:outline-none"
      aria-label="Language selector">
      <option value="/fr">FR</option>
      <option value="/en" selected>EN</option>
    </select>
  </div>

  <!-- Mobile Menu Button -->
  <button class="md:hidden ml-4" aria-label="Open menu">
    <Menu size={24} class="text-[#33499B]" />
  </button>
</header>

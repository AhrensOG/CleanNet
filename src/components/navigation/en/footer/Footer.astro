---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0f1d4a] text-white py-16 px-6">
  <div class="max-w-7xl mx-auto grid md:grid-cols-4 gap-10">
    <!-- Logo and description -->
    <div class="space-y-4">
      <a href="/fr" title="Accueil">
        <span class="text-4xl font-black tracking-tight">
          <span class="text-white">Clean</span><span
            class="text-cleannet-orange">Net</span
          >
        </span>
      </a>
      <p class="text-cleannet-orange font-medium tracking-wide">
        Votre propreté, notre priorité
      </p>
      <p class="text-sm text-[#BDBAC1]">
        Professional cleaning services<br />
        combining smart technology and human expertise.
      </p>
    </div>

    <!-- Company Links -->
    <div>
      <h4 class="text-white font-semibold mb-4">Company</h4>
      <ul class="space-y-2 text-sm text-[#BDBAC1]">
        <li><a href="/en" title="Home" class="hover:text-white">Home</a></li>
        <li>
          <a
            href="/en/services"
            title="View all services"
            class="hover:text-white">Services</a
          >
        </li>
        <li>
          <a href="/en/#about" title="About" class="hover:text-white">About</a>
        </li>
        <li>
          <a href="/en/contact" title="Contact" class="hover:text-white"
            >Contact</a
          >
        </li>
      </ul>
    </div>

    <!-- Services Links -->
    <div>
      <h4 class="text-white font-semibold mb-4">Our Services</h4>
      <ul class="space-y-2 text-sm text-[#BDBAC1]">
        <li>
          <a
            href="/en/services"
            title="View all services"
            class="hover:text-white">Residential Cleaning</a
          >
        </li>
        <li>
          <a
            href="/en/services"
            title="View all services"
            class="hover:text-white">Window Cleaning</a
          >
        </li>
        <li>
          <a
            href="/en/services"
            title="View all services"
            class="hover:text-white">Pest Control</a
          >
        </li>
        <li>
          <a
            href="/en/services"
            title="View all services"
            class="hover:text-white">Floor Care</a
          >
        </li>
      </ul>
    </div>

    <!-- Contact and WhatsApp -->
    <div class="space-y-4">
      <h4 class="text-white font-semibold mb-4">Contact</h4>
      <p class="text-sm text-[#BDBAC1]">
        📍 Av. des Communes-Réunies 70, 1212 Lancy
      </p>
      <a
        href="https://wa.me/41796425297?text=Bonjour%20CleanNet%2C%20je%20souhaite%20demander%20un%20devis"
        target="_blank"
        rel="noopener noreferrer"
        title="Contact us on WhatsApp"
        class="inline-block bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-full text-sm font-medium shadow-md transition">
        💬 Chat on WhatsApp
      </a>
    </div>
  </div>

  <!-- Bottom line -->
  <div
    class="border-t border-white/10 mt-12 pt-6 text-center text-sm text-[#BDBAC1]">
    © {currentYear} CleanNet. All rights reserved.
  </div>
</footer>

---
import { seoMeta } from "../metadata/SEOMeta";
import { buildHreflangs, getLangFromPath } from "../scripts/lang";

// Permitir pathname desde props para evitar errores en preview/build
const { pathname = "/" } = Astro.props;

const lang = getLangFromPath(pathname);
const hreflangs = buildHreflangs(pathname);
const canonicalUrl = `https://www.clean-net.ch${pathname}`;
const is404 = pathname.includes("/404");

const { title, description, ogImage, keywords } = seoMeta[pathname] || {
  title: "Clean Net – Nettoyage et Services à Genève",
  description: "Entreprise de nettoyage professionnel en Suisse romande.",
  ogImage: "https://www.clean-net.ch/favicon.svg",
  keywords: "nettoyage, services de nettoyage, Genève, conciergerie",
};
---

<!-- SEO esencial -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="robots" content={is404 ? "noindex, nofollow" : "index, follow"} />
<meta name="author" content="Clean Net" />
<meta name="publisher" content="Clean Net" />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta name="twitter:image" content={ogImage} />
    </>
  )
}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Canonical y hreflang -->
<link rel="canonical" href={canonicalUrl} />
{
  hreflangs.map(({ code, url }) => (
    <link rel="alternate" hreflang={code} href={url} />
  ))
}
<link rel="alternate" hreflang="x-default" href="https://www.clean-net.ch/" />

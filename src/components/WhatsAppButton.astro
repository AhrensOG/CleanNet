---
// WhatsAppButton.astro
---

<a
  id="whatsapp-conversion-btn"
  href="https://wa.me/41796425297?text=Bonjour%20CleanNet%2C%20je%20souhaite%20demander%20un%20devis"
  target="_blank"
  rel="noopener noreferrer"
  title="Contactez-nous sur WhatsApp"
  class="fixed z-50 bottom-5 right-5 bg-[#25D366] text-white p-4 rounded-full shadow-lg hover:scale-105 transition-transform duration-200"
  aria-label="Contact us on WhatsApp">
  <svg
    class="w-12 h-12 sm:w-16 sm:h-16"
    fill="currentColor"
    viewBox="0 0 24 24">
    <path
      d="M20.52 3.48A11.8 11.8 0 0 0 12 0C5.37 0 0 5.37 0 12a11.85 11.85 0 0 0 1.69 6.13L0 24l6.25-1.64A11.85 11.85 0 0 0 12 24c6.63 0 12-5.37 12-12 0-3.19-1.24-6.2-3.48-8.52zM12 22c-1.64 0-3.23-.4-4.65-1.15l-.33-.17-3.7.97.99-3.61-.21-.35A9.97 9.97 0 0 1 2 12c0-5.52 4.48-10 10-10 2.68 0 5.19 1.04 7.07 2.93A9.94 9.94 0 0 1 22 12c0 5.52-4.48 10-10 10zm5.27-7.61c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15s-.78.97-.95 1.17c-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.68-1.64-.93-2.26-.24-.56-.48-.48-.66-.48h-.56c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.48c0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.48.71.31 1.26.5 1.7.64.71.23 1.36.2 1.87.12.57-.08 1.78-.73 2.03-1.44.25-.71.25-1.31.18-1.44-.06-.13-.25-.2-.55-.35z"
    ></path>
  </svg>
</a>

<script>
  const setupConversionTrack = () => {
    const btn = document.getElementById(
      "whatsapp-conversion-btn"
    ) as HTMLAnchorElement | null;

    if (btn) {
      btn.addEventListener("click", (event) => {
        const gWindow = window as any;

        if (typeof gWindow.gtag === "function") {
          // Prevenimos la apertura inmediata para dejar que Ads registre el clic
          event.preventDefault();
          const url = btn.href;

          const callback = () => {
            // Si el enlace tiene target="_blank", abrimos en pestaña nueva, si no, redirigimos
            if (btn.target === "_blank") {
              window.open(url, "_blank");
            } else {
              window.location.href = url;
            }
          };

          gWindow.gtag("event", "conversion", {
            send_to: "AW-17131857885/K4lpCI6NsNMbEN3Pjek_",
            event_callback: callback,
          });

          // Seguridad: Si Google Ads no responde en 1 segundo, redirigimos igual
          setTimeout(callback, 1000);
        }
      });
    }
  };

  setupConversionTrack();
  document.addEventListener("astro:after-swap", setupConversionTrack);
</script>

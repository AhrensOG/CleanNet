---
import { Phone, MapPin, Clock } from "@lucide/astro";
---

<main>
  <section
    class="px-6 py-20 max-w-5xl mx-auto text-center space-y-6 text-cleannet-blue">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Contact Us</h1>
    <p class="text-lg text-gray-700 mb-4">
      Cleannet Victor Gonzalez – 70, Av. Communes Réunies, 1212 Grand-Lancy,
      Geneva.
    </p>
    <p class="text-base text-gray-600 mb-10">
      Reach out today! You can call us or chat with us on WhatsApp.
    </p>

    <!-- Contact Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10 text-left">
      <!-- Phone -->
      <div
        class="bg-white rounded-2xl shadow-md py-6 px-3 flex items-start gap-4 border border-gray-100">
        <div class="bg-cleannet-blue/10 p-3 rounded-full">
          <Phone class="text-cleannet-blue w-5 h-5" />
        </div>
        <div>
          <p
            class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-1">
            Phone
          </p>
          <a
            href="tel:+41796425297"
            class="text-cleannet-blue font-bold text-lg hover:underline">
            +41 79 642 52 97
          </a>
        </div>
      </div>

      <!-- Address -->
      <div
        class="bg-white rounded-2xl shadow-md py-6 px-3 flex items-start gap-4 border border-gray-100">
        <div class="bg-cleannet-blue/10 p-3 rounded-full">
          <MapPin class="text-cleannet-blue w-5 h-5" />
        </div>
        <div>
          <p
            class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-1">
            Address
          </p>
          <address
            class="not-italic text-gray-700 font-medium text-base leading-snug">
            Av. des Communes-Réunies 70<br />
            1212 Grand-Lancy, Geneva
          </address>
        </div>
      </div>

      <!-- Hours -->
      <div
        class="bg-white rounded-2xl shadow-md py-6 px-3 flex items-start gap-4 border border-gray-100">
        <div class="bg-cleannet-blue/10 p-3 rounded-full">
          <Clock class="text-cleannet-blue w-5 h-5" />
        </div>
        <div>
          <p
            class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-1">
            Opening Hours
          </p>
          <p class="text-gray-700 font-medium text-base leading-snug">
            Mon–Sat: 8:00am–7:00pm<br />
            <span class="text-red-400">Sunday: Closed</span>
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-col md:flex-row justify-center gap-6">
      <!-- WhatsApp Button -->
      <a
        href="https://wa.me/41796425297?text=Bonjour%20CleanNet%2C%20je%20souhaite%20demander%20un%20devis"
        target="_blank"
        rel="noopener noreferrer"
        title="Contact us on WhatsApp"
        class="inline-flex items-center gap-3 bg-green-500 hover:bg-green-600
      text-white font-semibold px-6 py-3 rounded-full transition text-lg
      shadow-lg">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M20.52 3.48A11.8 11.8 0 0 0 12 0C5.37 0 0 5.37 0 12a11.85 11.85 0 0 0 1.69 6.13L0 24l6.25-1.64A11.85 11.85 0 0 0 12 24c6.63 0 12-5.37 12-12 0-3.19-1.24-6.2-3.48-8.52zM12 22c-1.64 0-3.23-.4-4.65-1.15l-.33-.17-3.7.97.99-3.61-.21-.35A9.97 9.97 0 0 1 2 12c0-5.52 4.48-10 10-10 2.68 0 5.19 1.04 7.07 2.93A9.94 9.94 0 0 1 22 12c0 5.52-4.48 10-10 10zm5.27-7.61c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15s-.78.97-.95 1.17c-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.68-1.64-.93-2.26-.24-.56-.48-.48-.66-.48h-.56c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.48c0 1.46 1.06 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.48.71.31 1.26.5 1.7.64.71.23 1.36.2 1.87.12.57-.08 1.78-.73 2.03-1.44.25-.71.25-1.31.18-1.44-.06-.13-.25-.2-.55-.35z"
          ></path>
        </svg>
        Message on WhatsApp
      </a>
    </div>
  </section>
</main>

<!-- Map -->
<section class="px-6 pb-20 max-w-5xl mx-auto space-y-6">
  <h2 class="text-2xl font-bold text-cleannet-blue mb-4">Our Location</h2>
  <div class="w-full h-80 rounded-lg overflow-hidden shadow-md">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2762.880629307244!2d6.11774648713899!3d46.173031896563536!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x478c7b4f501327d7%3A0xbd8109e76375be5b!2sClean%20Net!5e0!3m2!1ses!2sch!4v1771603144376!5m2!1ses!2sch"
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>

  <div class="mt-8 text-center text-gray-600 text-lg font-medium">
    📍 70, Av. Communes Réunies, 1212 Grand-Lancy, Geneva<br />
    🕒 Monday to Saturday: 8:00am – 7:00pm
  </div>
</section>

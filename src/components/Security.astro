---
// src/components/Security.astro
const csp = [
  "default-src 'self'",
  // Añadimos *.google.ch y *.google.com.ar (o genéricos) para el soporte regional de scripts
  "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://*.google-analytics.com https://*.googleadservices.com https://*.doubleclick.net https://*.google.com https://*.google.ch",

  "script-src-elem 'self' 'unsafe-inline' https://*.googletagmanager.com https://*.googleadservices.com https://*.doubleclick.net https://*.google.com https://*.google.ch",

  // FALLA AQUÍ: Google necesita reportar la conversión a sus servidores de recolección
  "connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.googleadservices.com https://*.google.com https://*.google.ch ws://localhost:* http://localhost:*",

  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.googleapis.com",

  // Aseguramos que las imágenes de píxel de conversión (1x1) carguen
  "img-src 'self' data: https://*.googletagmanager.com https://*.google-analytics.com https://*.gstatic.com https://*.google.com https://*.google.ch https://*.googleadservices.com https://*.doubleclick.net https://*.google.com.ar",

  "font-src 'self' https://fonts.gstatic.com data:",

  "frame-src 'self' https://*.googletagmanager.com https://*.doubleclick.net https://*.google.com https://*.google.ch",
].join("; ");
---

<meta http-equiv="Content-Security-Policy" content={csp} />

<script async src="https://www.googletagmanager.com/gtag/js?id=AW-17131857885"
></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "AW-17131857885");
</script>

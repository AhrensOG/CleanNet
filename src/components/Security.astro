---
// src/components/Security.astro
const csp = [
  "default-src 'self'",
  // Agregamos dominios base sin comodín para asegurar compatibilidad con GTM
  "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://*.googleadservices.com https://*.doubleclick.net https://*.google.com https://*.google.ch",

  "script-src-elem 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://*.googleadservices.com https://*.doubleclick.net https://*.google.com https://*.google.ch",

  // Agregamos region1.google-analytics.com y otros colectores que usa GTM para las conversiones
  "connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.googleadservices.com https://*.google.com https://*.google.ch https://region1.google-analytics.com ws://localhost:* http://localhost:*",

  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.googleapis.com",

  // Google pide específicamente www.googletagmanager.com en img-src para sus píxeles de seguimiento
  "img-src 'self' data: https://www.googletagmanager.com https://*.googletagmanager.com https://*.google-analytics.com https://*.gstatic.com https://*.google.com https://*.google.ch https://*.googleadservices.com https://*.doubleclick.net",

  "font-src 'self' https://fonts.gstatic.com data:",

  // Añadimos google.com para el modo preview de Tag Assistant
  "frame-src 'self' https://www.googletagmanager.com https://*.googletagmanager.com https://*.doubleclick.net https://*.google.com https://*.google.ch",
].join("; ");
---

<meta http-equiv="Content-Security-Policy" content={csp} />

<script async src="https://www.googletagmanager.com/gtag/js?id=AW-17131857885"
></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  // El 'linker' es fundamental para que la conversión de WhatsApp se asocie a la sesión
  gtag("config", "AW-17131857885", {
    linker: { domains: ["wa.me", "calendly.com"] },
  });
  // gtag("config", "G-3EGMNS423Y");
</script>

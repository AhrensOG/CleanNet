---
interface Props {
  Icon: any;
  title: string;
  link: string;
}

const { Icon, title, link } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class="flex flex-col gap-4 p-4 md:p-6 w-full items-center border-b sm:border-b-0 sm:border-r border-[#BDBAC1]/40 last:border-none hover:bg-gray-50 transition-colors duration-200">
  <div class="bg-yellow-400 p-2 rounded-md text-[#111827]">
    <Icon class="w-6 h-6" />
  </div>
  <h3 class="text-lg font-semibold text-[#111827]">{title}</h3>
  <span class="text-[#33499B] text-4xl">→</span>
</a>

---
import { Phone } from "@lucide/astro";
---

<section
  class="relative bg-cleannet-blue text-white pt-20 px-0 md:py-20 md:px-6">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-10 items-center">
    <!-- Text -->
    <div class="space-y-6 z-10 px-6 md:px-0">
      <p class="uppercase text-sm font-medium tracking-wide text-white/80">
        Get in touch
      </p>
      <h2 class="text-4xl md:text-5xl font-extrabold leading-tight">
        Let’s discuss your needs or <br />
        <span class="relative inline-block">
          <span class="text-white relative">
            book an appointment
            <!-- SVG decoration stays the same -->
          </span>
        </span>
      </h2>
      <p class="text-white/80 text-base max-w-lg leading-relaxed">
        Your time is valuable. Call us directly or <strong
          >schedule a cleaning appointment online</strong
        > in just a few clicks.
      </p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <a
          href="tel:+410796425297"
          class="inline-flex items-center gap-2 px-6 py-3 bg-cleannet-orange hover:bg-orange-600 text-white font-semibold rounded-full shadow-md transition">
          <Phone size={18} />
          Call: +41 079 642 52 97
        </a>

        <a
          href="https://calendly.com/cleannet1963/30min"
          target="_blank"
          rel="noopener noreferrer"
          onclick="trackConversion()"
          class="inline-flex items-center px-6 py-3 border border-white rounded-full font-semibold hover:bg-white hover:text-cleannet-blue transition">
          Book an Appointment
        </a>
      </div>
    </div>

    <!-- Image -->
    <div
      class="md:absolute bottom-0 right-0 flex justify-center md:justify-end">
      <img
        src="/home/call_to_action/cta.webp"
        alt="Cleaning products and professional supplies"
        class="w-full max-w-2xl object-contain"
      />
    </div>
  </div>
</section>

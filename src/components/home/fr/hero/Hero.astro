---
import { Phone } from "@lucide/astro";
---

<!-- Préchargement de l'image de fond -->
<link
  rel="preload"
  as="image"
  href="/home/hero/banner.webp"
  type="image/webp"
/>

<section
  class="relative w-full min-h-[800px] sm:min-h-[700px] pt-11 text-cleannet-blue flex items-center">
  <!-- Image pour améliorer le LCP -->
  <img
    src="/home/hero/banner.webp"
    alt="Entreprise de nettoyage professionnel à Genève, Lancy et Carouge depuis 2002"
    class="absolute inset-0 w-full h-full object-cover z-[-1]"
    loading="eager"
    fetchpriority="high"
    width="1920"
    height="1080"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-white/40 backdrop-blur-sm"></div>

  <!-- Contenu -->
  <div
    class="relative z-10 w-full max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-8">
    <!-- Section texte -->
    <div class="flex-1 text-center md:text-left space-y-5">
      <p
        class="uppercase text-sm tracking-widest font-semibold text-cleannet-darkgray">
        Entreprise de nettoyage à Genève, Lancy et Carouge depuis 2002
      </p>

      <h1
        class="text-4xl md:text-5xl font-extrabold text-[#111827] leading-tight">
        Services professionnels de
        <span class="relative inline-block">
          <span class="text-cleannet-blue">nettoyage, conciergerie</span>
          <span
            class="absolute bottom-0 left-0 w-full h-2 bg-cleannet-orange z-[-1]"
          ></span>
        </span><br />
        et rénovation à Genève
      </h1>

      <p class="text-lg text-cleannet-blue font-bold">
        Appartements, bureaux, parquets, vitres, fin de chantier, déménagements
        et plus. Plus de 150 clients satisfaits. Service garanti et
        personnalisé.
      </p>

      <!-- Appels à l'action -->
      <div
        class="mt-6 flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a
          href=https://wa.me/41796425297?text=Bonjour%20CleanNet%2C%20je%20souhaite%20demander%20un%20devis
          title="Contactez-nous par appel"
          class="inline-flex items-center justify-center gap-2 bg-yellow-500 hover:bg-yellow-500/70 text-[#111827] font-semibold px-6 py-3 rounded-full transition text-base shadow-md">
          <Phone size={18} />
          Write to us
        </a>

        <!-- <a
          href="https://calendly.com/cleannet1963/30min"
          target="_blank"
          rel="noopener noreferrer"
          
          class="inline-flex items-center justify-center bg-cleannet-blue hover:bg-[#263a86] text-white font-semibold px-6 py-3 rounded-full transition text-base shadow-md">
          Prendre rendez-vous
        </a> -->
      </div>
    </div>
  </div>
</section>

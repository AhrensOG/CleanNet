---
import { Phone } from "@lucide/astro";
---

<section id="about" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
    <!-- Imagen doble -->
    <div class="relative w-full">
      <img
        src="/home/about/about_1.webp"
        alt="Service de nettoyage à Genève"
        class="rounded-lg shadow-lg w-full max-w-lg"
        title="Cleaning service in Geneva"
      />
      <img
        src="/home/about/about_2.webp"
        alt="Employé CleanNet"
        class="absolute bottom-[-40px] left-[-40px] w-48 md:w-60 rounded-lg border-4 border-white shadow-xl"
        title="CleanNet employee at work"
      />
    </div>

    <!-- Texte -->
    <div class="space-y-4 text-cleannet-blue">
      <p class="uppercase text-sm text-cleannet-blue font-medium">
        À propos de nous
      </p>
      <h2 class="text-4xl font-extrabold leading-tight">
        Votre <span class="relative inline-block">
          <span class="text-cleannet-orange">confort & propreté</span>
          <span
            class="absolute bottom-0 left-0 w-full h-2 bg-cleannet-gray z-[-1]">
          </span>
        </span><br />
        sont notre priorité
      </h2>
      <p class="text-cleannet-darkgray text-base leading-relaxed">
        Depuis 2002, CleanNet est une entreprise de nettoyage à Genève
        spécialisée dans l’entretien d’appartements, bureaux, vitrages, sols, et
        services de conciergerie et déménagements. Nous vous garantissons un
        environnement propre, sain et agréable grâce à notre équipe
        expérimentée.
      </p>
      <div class="space-y-1 text-sm font-medium">
        <p class="text-cleannet-blue">LUN–VEN 9h00 – 22h00</p>
        <p class="text-cleannet-blue">SAMEDI 9h00 – 20h00</p>
      </div>

      <a
        href="tel:+410796425297"
        title="Contactez-nous par appel"
        class="inline-flex items-center gap-2 bg-cleannet-orange hover:bg-cleannet-orange/90 text-white font-semibold px-6 py-3 rounded-full transition text-base mt-4 shadow-md">
        <Phone size={18} />
        Appeler : +41 079 642 5297
      </a>
    </div>
  </div>
</section>

<section class="py-20 bg-white border-t border-[#BDBAC1]/40">
  <div
    class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row gap-8 items-center sm:items-start justify-between"
    x-data="{
      active: 0,
      testimonials: [
        {
          name: 'Jack Morrison',
          age: 36,
          location: 'Genève',
          avatar: '/home/testimonials/t_1.webp',
          text: 'CleanNet est le meilleur service que j’ai utilisé. Leur équipe est ponctuelle, professionnelle et notre maison est toujours impeccable. Je recommande vivement !'
        },
        {
          name: 'Lucía Fernandes',
          age: 42,
          location: 'Genève',
          avatar: '/home/testimonials/t_2.webp',
          text: 'Depuis que nous avons fait appel à CleanNet, notre local est toujours étincelant. Ils sont rapides, ponctuels et très efficaces.'
        },
        {
          name: 'Youssef Ben Salah',
          age: 29,
          location: 'Genève',
          avatar: '/home/testimonials/t_3.webp',
          text: 'Des professionnels de confiance. Service irréprochable, équipe souriante et résultats à la hauteur de nos attentes.'
        }
      ]
    }">
    <!-- Avatares -->
    <div
      class="flex flex-col justify-center sm:flex-row items-center md:items-start gap-6">
      <template x-for="(testimonial, index) in testimonials" :key="index">
        <div
          :class="active === index ? 'opacity-100 scale-100' : 'opacity-50 grayscale'"
          @click="active = index"
          class="cursor-pointer transition-all duration-300 flex flex-col items-center">
          <img
            :src="testimonial.avatar"
            class="w-28 h-28 rounded-full border-4 border-white shadow-md"
          />
          <template x-if="active === index">
            <span class="mt-2 text-[#33499B] font-semibold">
              <svg class="w-8 h-8" fill="#FACC15" viewBox="0 0 24 24">
                <path
                  d="M9.5 11a3.5 3.5 0 0 1 0-7h.5v7H9.5Zm5 0a3.5 3.5 0 0 1 0-7h.5v7h-.5Z"
                ></path>
              </svg>
            </span>
          </template>
        </div>
      </template>
    </div>

    <!-- Témoignage -->
    <div class="flex-1 space-y-4 max-w-lg">
      <!-- Titre -->
      <div class="text-center md:text-left">
        <h2 class="text-3xl font-extrabold text-[#111827] mb-4">
          Ce que disent nos clients
        </h2>
      </div>

      <template x-for="(testimonial, index) in testimonials" :key="index">
        <div x-show="active === index" class="transition-all">
          <h3
            class="text-lg sm:text-xl font-bold text-[#111827]"
            x-text="testimonial.name + ', ' + testimonial.age + ' ans, ' + testimonial.location">
          </h3>
          <p
            class="text-[#65697C] text-base sm:text-lg leading-relaxed"
            x-text="testimonial.text">
          </p>
        </div>
      </template>

      <!-- Navigation -->
      <div class="flex gap-4 pt-6">
        <button
          @click="active = (active - 1 + testimonials.length) % testimonials.length"
          class="p-2 rounded-full border text-[#33499B] hover:bg-[#f3f4f6]">
          ←
        </button>
        <button
          @click="active = (active + 1) % testimonials.length"
          class="p-2 rounded-full border text-[#33499B] hover:bg-[#f3f4f6]">
          →
        </button>
      </div>
    </div>
  </div>
</section>

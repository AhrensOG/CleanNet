---
// Componente reutilizable de tarjeta de servicio
export interface Props {
  title: string;
  description: string;
  Icon: any;
  keywords: string[];
}
---

<div class="flex flex-col items-center text-center gap-4 bg-white rounded-xl shadow-md p-6 border border-cleannet-gray/30 transition hover:shadow-xl">
  <!-- Icono -->
  <div class="text-cleannet-blue">
    <Astro.props.Icon size={36} strokeWidth={1.8} />
  </div>

  <!-- Título -->
  <h3 class="text-lg font-semibold text-[#0f172a]">{Astro.props.title}</h3>

  <!-- Descripción -->
  <p class="text-cleannet-darkgray text-sm leading-relaxed">
    {Astro.props.description}
  </p>

  <!-- Palabras clave ocultas para SEO -->
  <div class="sr-only">
    {Astro.props.keywords.map((word) => <span>{word}</span>)}
  </div>
</div>

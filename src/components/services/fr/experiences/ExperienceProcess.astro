---
import { BadgeCheck, Users, LayoutGrid, ThumbsUp } from "@lucide/astro";
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 text-center space-y-10">
    <!-- Titre -->
    <h2
      class="text-4xl md:text-5xl font-extrabold text-cleannet-blue leading-tight text-start">
      Pourquoi choisir
      <span class="relative inline-block">
        <span class="text-cleannet-blue font-extrabold">CleanNet</span>
        <svg
          class="absolute -bottom-1 left-0 w-full h-3 text-cleannet-orange z-[-1]"
          viewBox="0 0 200 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M2 10C12 7 29 5 44 9.5C59 14 65 11 85 8C105 5 125 13.5 144 10C163 6.5 180 3 198 6"
            stroke="currentColor"
            stroke-width="6"
            stroke-linecap="round"></path>
        </svg>
      </span>
      ?
    </h2>

    <!-- Sous-titre -->
    <p
      class="text-cleannet-darkgray text-base max-w-3xl mx-auto leading-relaxed">
      Depuis 2002, CleanNet accompagne particuliers et entreprises à Genève avec
      <strong>un service complet, fiable et professionnel</strong> — du nettoyage
      à la rénovation, en passant par le déménagement et la conciergerie.
    </p>

    <!-- Quatre raisons -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pt-10">
      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-cleannet-blue text-white p-4 rounded-full">
          <BadgeCheck class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg text-cleannet-blue">
          +20 ans d'expérience
        </h3>
        <p class="text-sm text-cleannet-darkgray">
          Une expertise acquise depuis 2002 dans le nettoyage, les parquets, la
          rénovation et bien plus encore.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-cleannet-orange text-white p-4 rounded-full">
          <Users class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg text-cleannet-blue">
          Équipe de confiance
        </h3>
        <p class="text-sm text-cleannet-darkgray">
          Personnel qualifié, discret et ponctuel. Chaque intervention est
          réalisée avec rigueur et respect de votre espace.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-cleannet-blue text-white p-4 rounded-full">
          <LayoutGrid class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg text-cleannet-blue">Service tout-en-un</h3>
        <p class="text-sm text-cleannet-darkgray">
          Nettoyage, déménagement, rénovation, jardinage — un seul prestataire
          pour tous vos besoins à Genève.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-cleannet-orange text-white p-4 rounded-full">
          <ThumbsUp class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg text-cleannet-blue">
          Satisfaction garantie
        </h3>
        <p class="text-sm text-cleannet-darkgray">
          Chaque prestation se termine par un contrôle qualité pour assurer
          votre entière satisfaction.
        </p>
      </div>
    </div>
  </div>
</section>

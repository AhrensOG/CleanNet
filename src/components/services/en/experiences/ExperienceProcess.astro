---
import { Sparkles, ShieldCheck, Brush, HeartPulse } from "@lucide/astro";
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 text-center space-y-10">
    <!-- Title -->
    <h2
      class="text-4xl md:text-5xl font-extrabold text-[#0f172a] leading-tight text-start">
      A proven process for
      <span class="relative inline-block">
        <span class="text-[#0f172a] font-extrabold">over 20 years</span>
        <svg
          class="absolute -bottom-1 left-0 w-full h-3 text-green-400 z-[-1]"
          viewBox="0 0 200 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M2 10C12 7 29 5 44 9.5C59 14 65 11 85 8C105 5 125 13.5 144 10C163 6.5 180 3 198 6"
            stroke="currentColor"
            stroke-width="6"
            stroke-linecap="round"></path>
        </svg>
      </span>
      delivering cleanliness in Geneva
    </h2>

    <!-- Subtitle -->
    <p
      class="text-cleannet-darkgray text-base max-w-3xl mx-auto leading-relaxed">
      CleanNet offers a wide range of <strong
        >professional cleaning services in Geneva</strong
      > — from deep cleaning to concierge support. Our modern methods ensure spotless
      results with every visit.
    </p>

    <!-- Four Steps -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pt-10">
      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-indigo-600 text-white p-4 rounded-full">
          <Sparkles class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg">1. Hygiene & Cleanliness</h3>
        <p class="text-sm text-cleannet-darkgray">
          Professional hygiene services with meticulous attention to every
          detail.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-indigo-600 text-white p-4 rounded-full">
          <ShieldCheck class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg">2. Safety Protocols</h3>
        <p class="text-sm text-cleannet-darkgray">
          Our teams follow strict procedures to ensure a safe and secure
          environment.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-indigo-600 text-white p-4 rounded-full">
          <Brush class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg">3. Deep Cleaning</h3>
        <p class="text-sm text-cleannet-darkgray">
          We remove dirt, stains and embedded residues for an immaculate finish.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-indigo-600 text-white p-4 rounded-full">
          <HeartPulse class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg">4. Sanitary Inspection</h3>
        <p class="text-sm text-cleannet-darkgray">
          Every service ends with a quality check to ensure hygiene and
          well-being.
        </p>
      </div>
    </div>
  </div>
</section>

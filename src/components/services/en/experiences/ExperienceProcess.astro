---
import { BadgeCheck, Users, LayoutGrid, ThumbsUp } from "@lucide/astro";
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-6 text-center space-y-10">
    <!-- Title -->
    <h2
      class="text-4xl md:text-5xl font-extrabold text-cleannet-blue leading-tight text-start">
      Why choose
      <span class="relative inline-block">
        <span class="text-cleannet-blue font-extrabold">CleanNet</span>
        <svg
          class="absolute -bottom-1 left-0 w-full h-3 text-cleannet-orange z-[-1]"
          viewBox="0 0 200 20"
          fill="none"
          xmlns="http://www.w3.org/2000/svg">
          <path
            d="M2 10C12 7 29 5 44 9.5C59 14 65 11 85 8C105 5 125 13.5 144 10C163 6.5 180 3 198 6"
            stroke="currentColor"
            stroke-width="6"
            stroke-linecap="round"></path>
        </svg>
      </span>
      ?
    </h2>

    <!-- Subtitle -->
    <p
      class="text-cleannet-darkgray text-base max-w-3xl mx-auto leading-relaxed">
      Since 2002, CleanNet has supported individuals and businesses across
      Geneva with
      <strong>a complete, reliable and professional service</strong> — from cleaning
      to renovation, moving and concierge services.
    </p>

    <!-- Four reasons -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pt-10">
      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-cleannet-blue text-white p-4 rounded-full">
          <BadgeCheck class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg text-cleannet-blue">
          20+ years of experience
        </h3>
        <p class="text-sm text-cleannet-darkgray">
          Expertise built since 2002 across cleaning, parquet floors, renovation
          and much more.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-cleannet-orange text-white p-4 rounded-full">
          <Users class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg text-cleannet-blue">Trusted team</h3>
        <p class="text-sm text-cleannet-darkgray">
          Qualified, discreet and punctual staff. Every visit is carried out
          with care and respect for your space.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-cleannet-blue text-white p-4 rounded-full">
          <LayoutGrid class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg text-cleannet-blue">All-in-one service</h3>
        <p class="text-sm text-cleannet-darkgray">
          Cleaning, moving, renovation, gardening — one provider for all your
          needs in Geneva.
        </p>
      </div>

      <div class="flex flex-col items-center text-center space-y-4">
        <div class="bg-cleannet-orange text-white p-4 rounded-full">
          <ThumbsUp class="w-14 h-14" />
        </div>
        <h3 class="font-bold text-lg text-cleannet-blue">
          Satisfaction guaranteed
        </h3>
        <p class="text-sm text-cleannet-darkgray">
          Every service ends with a quality check to ensure your complete
          satisfaction.
        </p>
      </div>
    </div>
  </div>
</section>
